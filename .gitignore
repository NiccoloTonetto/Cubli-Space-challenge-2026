# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp

# --- MATLAB / Simulink ---
# .slxc is the Simulink build cache, .asv/.autosave are editor autosaves,
# .original is Simulink's pre-edit backup, slprj/ is the project build dir.
*.slxc
*.asv
*.autosave
*.original
slprj/
codegen/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Arduino / PlatformIO ---
# Scoped to firmware/ on purpose: a bare "build/" would also swallow
# figures/build/, which holds photographs of the physical build.
firmware/**/build/
.pio/
*.hex
*.elf

# --- KiCad ---
# .kicad_prl is per-user editor state, not design data.
*.kicad_prl
*-backups/
fp-info-cache
*.bak

# --- Telemetry ---
# Raw captures land here during a session. Only curated runs are committed,
# under data/ -- see data/README.md.
firmware/**/telemetry/

# --- Arduino sketchbook libraries ---
# The Arduino IDE installs vendor libraries into whatever it thinks the
# sketchbook is. If that ever points at this repo, this stops the resulting
# copies -- or local symlinks -- from landing in git. Libraries belong in
# ~/Documents/Arduino/libraries, installed once per machine.
/libraries/
